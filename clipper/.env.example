# Clave de la API de Claude (https://console.anthropic.com). Sin ella se usa la heurística local.
ANTHROPIC_API_KEY=

# --- Opcionales: quita el # para cambiar el valor por defecto ---

# Modelo de Claude que elige los momentos
# CLIPPER_MODEL=claude-opus-5-5

# Esfuerzo de razonamiento: low | medium | high | xhigh | max
# CLIPPER_EFFORT=high

# auto = usa Claude si hay credenciales; heuristica = fuerza el modo sin IA
# CLIPPER_SELECTOR=auto

# Modelo de transcripción: tiny | base | small | medium | large-v3
# CLIPPER_WHISPER_MODEL=small

# auto | cpu | cuda
# CLIPPER_WHISPER_DEVICE=auto

# Dónde se guardan videos y clips
# CLIPPER_DATA_DIR=./data

# Segundos máximos al grabar una transmisión en vivo (.m3u8)
# CLIPPER_MAX_CAPTURA=600

# Fuente de los subtítulos
# CLIPPER_FUENTE=Inter
